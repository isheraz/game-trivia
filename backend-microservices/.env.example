# Environment variables for local development
# Copy to .env and fill in your values

# Supabase (auto-configured when running `supabase start`)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=my_secure_webhook_token_123
WHATSAPP_API_VERSION=v18.0

# Admin Configuration
ADMIN_EMAILS=admin@qrush.com,youremail@example.com
ADMIN_DEV_PASSWORD=dev123  # For local testing without JWT

# App Configuration
DEFAULT_PRIZE_POOL=100
QUESTION_TIMER=10
MAX_PLAYERS=100

# Test Configuration
# TEST_PHONE=923196612416
TEST_PHONE=923196612416
